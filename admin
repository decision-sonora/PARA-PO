<!DOCTYPE html>
<html>
<head>
    <title>Admin - PARA-PO</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        body { font-family: Arial; background: #1e1e2f; color: white; padding: 20px; }
        h1 { color: #00f2c3; }
        button { padding: 15px 30px; font-size: 18px; background: #00f2c3; border: none; border-radius: 8px; cursor: pointer; margin: 10px; font-weight: bold; }
        button:hover { background: #00c9a3; }
        #stop-btn { background: #fd5d93; color: white; }
        #stop-btn:hover { background: #d14676; }
        #map { height: 500px; margin-top: 20px; border-radius: 8px; border: 2px solid #00f2c3; }
        #status { font-size: 18px; margin-top: 20px; font-weight: bold; color: #00f2c3; }
    </style>
</head>
<body>
    <h1>🛡️ PARA-PO Admin Control Hub</h1>
    <p>This page is for the system administrator only. Use it to simulate vehicles for testing.</p>
    
    <button onclick="summonTestJeepney()">🚐 Summon Test Jeepney</button>
    <button id="stop-btn" onclick="stopTestJeepney()">🛑 Stop Test Jeepney</button>
    
    <p id="status">Status: Idle</p>
    <div id="map"></div>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        const map = L.map('map').setView([6.9273, 122.0588], 14);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);

        let testMarker = null;

        async function summonTestJeepney() {
            document.getElementById('status').innerText = "Status: Summoning...";
            try {
                const res = await fetch('/api/admin/summon-test', { method: 'POST' });
                const data = await res.json();
                
                if (data.status === 'success') {
                    document.getElementById('status').innerText = "Status: Test Jeepney is LIVE on the main map!";
                    
                    if (testMarker) map.removeLayer(testMarker);
                    const icon = L.divIcon({ className: 'icon', html: '🚐', iconSize: [30, 30] });
                    testMarker = L.marker([data.lat, data.lon], {icon: icon}).addTo(map).bindPopup("Test Jeepney").openPopup();
                    
                    // Move marker visually to show it's active
                    setInterval(() => {
                        if(testMarker) {
                            testMarker.setLatLng([testMarker.getLatLng().lat + (Math.random()-0.5)*0.0001, testMarker.getLatLng().lng + (Math.random()-0.5)*0.0001]);
                        }
                    }, 3000);
                    
                } else {
                    document.getElementById('status').innerText = "Error: " + data.message;
                }
            } catch (err) {
                document.getElementById('status').innerText = "Network Error.";
            }
        }

        async function stopTestJeepney() {
            await fetch('/api/admin/stop-test', { method: 'POST' });
            document.getElementById('status').innerText = "Status: Test Jeepney stopped.";
            if (testMarker) { map.removeLayer(testMarker); testMarker = null; }
        }
    </script>
</body>
</html>
